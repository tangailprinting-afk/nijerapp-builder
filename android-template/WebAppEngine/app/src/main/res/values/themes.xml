<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base Theme -->

    <style
        name="Base.Theme.WebAppEngine"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- STATUS BAR -->

        <item name="android:windowDrawsSystemBarBackgrounds">
            true
        </item>

        <item name="android:statusBarColor">
            #000000
        </item>

        <!-- NAVIGATION BAR -->

        <item name="android:navigationBarColor">
            #000000
        </item>

        <!-- DISABLE FULLSCREEN -->

        <item name="android:windowFullscreen">
            false
        </item>

    </style>

    <style
        name="Theme.WebAppEngine"
        parent="Base.Theme.WebAppEngine" />

</resources>