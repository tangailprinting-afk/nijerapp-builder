{
  "name": "sultan-digital-sign",
  "version": "1.0.0",
  "description": "Print Shop Management System - Sultan Digital Sign",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Sultan Digital Sign",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.sultandigitalsign.app",
    "productName": "Sultan Digital Sign",
    "icon": "icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sultan Digital Sign",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}